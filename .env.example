# LoreKeeper Environment Variables

# Gemini API Key (optional, nur wenn llm.provider = gemini)
GEMINI_API_KEY=

# ChromaDB-Modus (embedded = im Backend-Prozess, client = externer Server — ungenutzt)
# VECTORSTORE__MODE=embedded

# LLM Provider Override
# LLM__PROVIDER=ollama
# LLM__OLLAMA__BASE_URL=http://127.0.0.1:11434
# LLM__OLLAMA__MODEL=qwen3:14b

# UI-Zugriffsschutz (Heimnetz, siehe docs/operations.md "Home-network server")
# Schützt Sources/Evaluation/Prompts/Settings und Provider-/Gemini-Key-Wechsel im Chat.
# Leer = alles offen (lokaler Einzelbetrieb).
LOREKEEPER_ADMIN_PASSWORD=

# Backend-URL für die UI (Default http://127.0.0.1:8000 — nicht "localhost", das kostet unter Windows ~2 s pro Verbindung)
# LOREKEEPER_API_URL=http://127.0.0.1:8000
